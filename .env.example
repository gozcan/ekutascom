# --- SMTP ayarları (Vercel → Project Settings → Environment Variables) ---

# Sunucu adresi (sağlayıcıdan)
SMTP_HOST=mail.eksioglugrup.tr

# 465 (SSL) ya da 587 (STARTTLS)
SMTP_PORT=465

# 465 için "true", 587 için "false"
SMTP_SECURE=true

# SMTP kullanıcı adı = e-posta adresi
SMTP_USER=info@ekutas.com

# E-posta hesabının şifresi
SMTP_PASS=

# Formdan gelen mesajların gönderileceği adres
# (Birden fazla için virgülle ayırın: info@ekutas.com,baska@ekutas.com)
MAIL_TO=info@ekutas.com

# Görünen "kimden" (boş bırakılırsa SMTP_USER kullanılır)
MAIL_FROM="Ekutaş Web <info@ekutas.com>"
